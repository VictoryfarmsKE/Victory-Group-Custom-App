{
  "doctype": "DocType",
  "name": "Lease Contract",
  "module": "Accounts",
  "custom": 1,
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "naming_series",
  "editable_grid": 1,
  "engine": "InnoDB",
  "allow_rename": 1,
  "index_web_pages_for_search": 1,
  "grid_page_length": 50,
  "row_format": "Dynamic",
  "sort_field": "modified",
  "sort_order": "DESC",

  "field_order": [
    "organization_details",
    "company",
    "region",
    "branch",
    "cost_center",
    "department",

    "lease_section",
    "lessor",
    "contact_person",
    "email",
    "mobile_no",
    "lessor_type",

    "lease_term",
    "lease_start_date",
    "lease_end_date",
    "lease_duration_months",
    "renewal_notice_days",
    "rent_amount",
    "Initial_rent_months",
    "Initial_rent_amount",
    "security_deposit",

    "tracking_section",
    "total_months",
    "paid_months",
    "pending_months",
    "next_po_date",
    "billing_frequency",

    "payment_section",
    "payment_method",
    "bank_name",
    "bank_code",
    "bank_account_number",
    "mpesa_till_number",
    "mpesa_paybill_number",
    "direct_mobile_number",

    "Accounting_details",
    "expense_account",
    "payable_account",
    "auto_create_purchase_order",
    "lease_status",

    "termination_tab",
    "termination_status",
    "termination_date",
    "termination_reason",
    "termination_penalty",
    "termination_notes"
  ],

  "fields": [
    {
      "fieldname": "organization_details",
      "fieldtype": "Section Break",
      "label": "Organization Details"
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Naming Series",
      "options": "LC-.YYYY.-",
      "reqd": 1
  },
    {
      "fieldname": "region",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Warehouse",
      "reqd": 1
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Warehouse",
      "reqd": 1
    },
    {
      "fieldname": "cost_center",
      "fieldtype": "Link",
      "label": "Cost Center",
      "options": "Cost Center",
      "reqd": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department",
      "reqd": 1
    },

    {
      "fieldname": "lease_section",
      "fieldtype": "Section Break",
      "label": "Lessor Details"
    },
    {
      "fieldname": "lessor",
      "fieldtype": "Link",
      "label": "Lessor",
      "options": "Supplier",
      "reqd": 1
    },
    {
      "fieldname": "contact_person",
      "fieldtype": "Data",
      "label": "Contact Person"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email"
    },
    {
      "fieldname": "mobile_no",
      "fieldtype": "Data",
      "label": "Mobile No"
    },
    {
      "fieldname": "lessor_type",
      "fieldtype": "Select",
      "label": "Lessor Type",
      "options": "\nIndividual\nCompany",
      "fetch_from": "lessor.supplier_type",
      "read_only": 1
    },

    {
      "fieldname": "lease_term",
      "fieldtype": "Section Break",
      "label": "Lease Term"
    },
    {
      "fieldname": "lease_start_date",
      "fieldtype": "Date",
      "label": "Lease Start Date",
      "reqd": 1
    },
    {
      "fieldname": "lease_end_date",
      "fieldtype": "Date",
      "label": "Lease End Date",
      "reqd": 1
    },
    {
      "fieldname": "lease_duration_months",
      "fieldtype": "Int",
      "label": "Lease Duration (Months)",
      "read_only": 1
    },
    {
      "fieldname": "renewal_notice_days",
      "fieldtype": "Int",
      "label": "Lease Notice Period (Days)"
    },
    {
      "fieldname": "rent_amount",
      "fieldtype": "Currency",
      "label": "Monthly Rent Amount",
      "reqd": 1
    },
    {
      "fieldname": "Initial_rent_months",
      "fieldtype": "Int",
      "label": "Initial Rent Payment (Months)",
      "read_only": 1
    },
    {
      "fieldname": "Initial_rent_amount",
      "fieldtype": "Currency",
      "label": "Initial Rent Amount",
      "read_only": 1
    },
    {
      "fieldname": "security_deposit",
      "fieldtype": "Currency",
      "label": "Security Deposit"
    },

    {
      "fieldname": "tracking_section",
      "fieldtype": "Section Break",
      "label": "Lease Tracking"
    },
    {
      "fieldname": "total_months",
      "fieldtype": "Int",
      "label": "Total Lease Months",
      "read_only": 1
    },
    {
      "fieldname": "paid_months",
      "fieldtype": "Int",
      "label": "Paid Months at Creation",
      "default": 0
    },
    {
      "fieldname": "pending_months",
      "fieldtype": "Int",
      "label": "Pending Months",
      "read_only": 1
    },
    {
      "fieldname": "next_po_date",
      "fieldtype": "Date",
      "label": "Next PO Date"
    },
    {
      "fieldname": "billing_frequency",
      "fieldtype": "Select",
      "label": "Billing Frequency",
      "options": "\nMonthly\nQuarterly"
    },

    {
      "fieldname": "payment_section",
      "fieldtype": "Section Break",
      "label": "Payment Details"
    },
    {
      "fieldname": "payment_method",
      "fieldtype": "Select",
      "label": "Payment Method",
      "options": "\nBank\nMpesa - Till Number\nMpesa - Paybill\nDirect Mobile",
      "reqd": 1
    },
    {
      "fieldname": "bank_name",
      "fieldtype": "Data",
      "label": "Bank Name",
      "depends_on": "eval:doc.payment_method == 'Bank'",
      "fetch_from": "lessor.bank_name",
      "read_only": 1
    },
    {
      "fieldname": "bank_code",
      "fieldtype": "Data",
      "label": "Bank Code",
      "depends_on": "eval:doc.payment_method == 'Bank'",
      "fetch_from": "lessor.bank_code",
      "read_only": 1
    },
    {
      "fieldname": "bank_account_number",
      "fieldtype": "Data",
      "label": "Bank Account Number",
      "depends_on": "eval:doc.payment_method == 'Bank'",
      "fetch_from": "lessor.bank_account_number",
      "read_only": 1
    },
    {
      "fieldname": "mpesa_till_number",
      "fieldtype": "Data",
      "label": "Mpesa Till Number",
      "depends_on": "eval:doc.payment_method == 'Mpesa - Till Number'",
      "fetch_from": "lessor.mpesa_till_number",
      "read_only": 1
    },
    {
      "fieldname": "mpesa_paybill_number",
      "fieldtype": "Data",
      "label": "Mpesa Paybill Number",
      "depends_on": "eval:doc.payment_method == 'Mpesa - Paybill'",
      "fetch_from": "lessor.mpesa_paybill_number",
      "read_only": 1
    },
    {
      "fieldname": "direct_mobile_number",
      "fieldtype": "Data",
      "label": "Direct Mobile Number",
      "depends_on": "eval:doc.payment_method == 'Direct Mobile'",
      "fetch_from": "lessor.mobile_no",
      "read_only": 1
    },

    {
      "fieldname": "Accounting_details",
      "fieldtype": "Section Break",
      "label": "Accounting Details"
    },
    {
      "fieldname": "expense_account",
      "fieldtype": "Link",
      "label": "Expense Account",
      "options": "Account",
      "reqd": 1
    },
    {
      "fieldname": "payable_account",
      "fieldtype": "Link",
      "label": "Payable Account",
      "options": "Account"
    },
    {
      "fieldname": "auto_create_purchase_order",
      "fieldtype": "Check",
      "label": "Auto Create Purchase Orders",
      "default": 1
    },
    {
      "fieldname": "lease_status",
      "fieldtype": "Select",
      "label": "Lease Status",
      "options": "\nDraft\nActive\nExpired\nTerminated",
      "default": "Draft"
    },

    {
      "fieldname": "termination_tab",
      "fieldtype": "Tab Break",
      "label": "Termination Details"
    },
    {
      "fieldname": "termination_status",
      "fieldtype": "Select",
      "label": "Termination Status",
      "options": "\nNot Terminated\nPending Termination\nTerminated",
      "default": "Not Terminated"
    },
    {
      "fieldname": "termination_date",
      "fieldtype": "Date",
      "label": "Termination Date",
      "depends_on": "eval:doc.termination_status == 'Terminated'"
    },
    {
      "fieldname": "termination_reason",
      "fieldtype": "Select",
      "label": "Termination Reason",
      "options": "\nLease Expiry\nEarly Termination\nBreach of Contract\nMutual Agreement\nOther",
      "depends_on": "eval:doc.termination_status != 'Not Terminated'"
    },
    {
      "fieldname": "termination_penalty",
      "fieldtype": "Currency",
      "label": "Early Termination Penalty",
      "depends_on": "eval:doc.termination_reason == 'Early Termination'"
    },
    {
      "fieldname": "termination_notes",
      "fieldtype": "Small Text",
      "label": "Termination Notes",
      "depends_on": "eval:doc.termination_status != 'Not Terminated'"
    }
  ],

  "permissions": [
    {
      "role": "Accounts User",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Lease Creator",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Lease Approver",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
